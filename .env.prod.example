# 운영 환경 변수 (VM의 ~/duty/.env.prod 로 복사해 채우고 chmod 600). 커밋하지 않는다. Build Spec 3-1
# 접속 도메인 — DNS A 레코드가 VM 고정 IP를 가리켜야 Caddy가 인증서를 받는다
DOMAIN=duty.example.com

# DB (POSTGRES_PASSWORD는 긴 무작위 값: openssl rand -base64 32)
POSTGRES_USER=duty
POSTGRES_PASSWORD=
POSTGRES_DB=duty

# 최초 부팅 db:bootstrap 전용 — 첫 관리자(수간호사) 사번·이름
ADMIN_EMPLOYEE_NO=
ADMIN_NAME=

# 공공데이터포털 특일 정보 Decoding 인증키(선택)
HOLIDAY_API_KEY=

# 솔버 작업자 수 = VM vCPU 수
SOLVER_WORKERS=2

# 백업: age 공개키(age1...) — 개인키는 서버에 두지 않는다(docs/operations.md 「백업 키」)
BACKUP_AGE_RECIPIENT=
# rclone 대상. GCS는 VM 서비스 계정으로 인증(키 파일 없음). 비우면 서버(./backups)에만
BACKUP_REMOTE=:gcs,env_auth=true,bucket_policy_only=true:버킷이름/duty
BACKUP_DIR=./backups
