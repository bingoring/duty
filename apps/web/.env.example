# 개발: compose.yaml의 db (호스트 포트 5433)
DATABASE_URL=postgres://duty:duty@localhost:5433/duty
# 통합 테스트 전용 DB (compose가 함께 생성)
TEST_DATABASE_URL=postgres://duty:duty@localhost:5433/duty_test
# 운영 최초 부팅(db:bootstrap) 전용
ADMIN_EMPLOYEE_NO=
ADMIN_NAME=
# E2E 전용 DB (없으면 e2e 전역 설정이 만든다)
E2E_DATABASE_URL=postgres://duty:duty@localhost:5433/duty_e2e
# 공공데이터포털 「한국천문연구원_특일 정보」 Decoding 인증키(선택). 규칙 설정 → 공휴일 가져오기에 쓴다
HOLIDAY_API_KEY=
